rules_version = '2';
// Paste into Firebase console → Firestore Database → Rules, then Publish.
// Who can sign in lives in the access/roles document: {parents: [emails], members: [emails]}.
// Parents can change everything. Members (kids) can only record check-offs (the done and log fields).
service cloud.firestore {
  match /databases/{database}/documents {
    function myEmail() {
      return request.auth != null && request.auth.token.email_verified == true
        ? request.auth.token.email.lower() : '';
    }
    function roles() { return get(/databases/$(database)/documents/access/roles).data; }
    function isParent() { return myEmail() != '' && myEmail() in roles().parents; }
    function isMember() { return isParent() || (myEmail() != '' && myEmail() in roles().members); }

    function validRoles(d) {
      return d.keys().hasOnly(['parents', 'members'])
        && d.parents is list && d.members is list
        && d.parents.size() >= 1 && d.parents.size() <= 20 && d.members.size() <= 50;
    }
    function validHousehold(d) {
      return d.keys().hasOnly(['people', 'chores', 'done', 'log'])
        && d.people is list && d.people.size() <= 30
        && d.chores is list && d.chores.size() <= 100
        && d.done is map && d.done.size() <= 200
        && d.log is list && d.log.size() <= 500;
    }

    match /access/roles {
      // Signed-in people may see that the list doesn't exist yet (for first-time setup); otherwise members only.
      allow read: if isMember() || (myEmail() != '' && resource == null);
      // First-time setup: whoever signs in first, before the list exists, becomes the only parent.
      allow create: if myEmail() != '' && request.resource.data.parents == [myEmail()]
        && request.resource.data.members == [] && validRoles(request.resource.data);
      // A parent can't remove themselves, so the family can't lock itself out by accident.
      allow update: if isParent() && validRoles(request.resource.data)
        && myEmail() in request.resource.data.parents;
    }

    match /households/{id} {
      allow read: if isMember();
      allow create: if isParent() && validHousehold(request.resource.data);
      allow update: if validHousehold(request.resource.data) && (
        isParent()
        || (isMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'log']))
      );
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
